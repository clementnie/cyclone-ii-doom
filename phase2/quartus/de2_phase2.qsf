# Original DE2: EP2C35F672C6. See reference/DE2_Pin_Table.pdf.
# Quartus QSF targets use double quotes; braces become literal name characters.
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C35F672C6
set_global_assignment -name TOP_LEVEL_ENTITY de2_phase2
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE de2_phase2.sdc
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name VERILOG_FILE ../rtl/de2_phase2.v
set_global_assignment -name VERILOG_FILE ../rtl/onchip_memory.v
set_global_assignment -name VERILOG_FILE ../rtl/phase2_soc.v
set_global_assignment -name VERILOG_FILE ../rtl/rv32i_cpu.v
set_global_assignment -name VERILOG_FILE ../rtl/soc_bus.v
set_global_assignment -name VERILOG_FILE ../rtl/vga_tiles.v
set_global_assignment -name VERILOG_FILE ../../rtl/ps2_keyboard_mmio.v
set_global_assignment -name VERILOG_FILE ../../rtl/ps2_receiver.v
set_global_assignment -name VERILOG_FILE ../../rtl/ps2_scancode_decoder.v
set_location_assignment PIN_N2 -to CLOCK_50
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_location_assignment PIN_G26 -to KEY[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to KEY[0]
